# GreenAgent OS — Configuration Template
PROJECT_NAME="GreenAgent OS"
VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=false

# Security & API Keys
SECRET_KEY=greenagent-os-super-secret-dev-key-change-in-prod
API_KEY_HEADER_NAME=X-API-Key
DEFAULT_API_KEY=ga-dev-test-key-2026

# Database
DATABASE_URL=sqlite:///./greenagent.db

# Ollama / Local Inference (zero GPU required)
OLLAMA_BASE_URL=http://localhost:11434
SIMULATE_INFERENCE_IF_UNAVAILABLE=true

# Datacenter & Grid Defaults
DATACENTER_PUE=1.25
DEFAULT_REGION=us-east

# Optimization Weights Default
OPT_ALPHA=0.25
OPT_BETA=0.35
OPT_GAMMA=0.20
OPT_DELTA=0.10
OPT_EPSILON=0.10
